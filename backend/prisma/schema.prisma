generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String   @unique
  isNew            Boolean  @default(false)
  description      String
  shortDescription String
  additionalInfo   String?
  price            Float
  discountPrice    Float?
  category         String
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  stock            Int      @default(0)
  colors           String[]
  sizes            String[]
  images           String[]
  sku              String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductCart {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  currentCount Int
  currentColor String
  currentSize  String
  productSlug  String
  userId       String @db.ObjectId
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, productSlug, currentColor, currentSize])
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  password     String
  productsCart ProductCart[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
